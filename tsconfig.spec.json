{
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "dom"],
    "types": ["jasmine", "node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*.spec.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
